<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>유튜브 프로 썸네일 스튜디오 (네온사인 에디션 - 확장판)</title>
  <!-- Google Fonts에서 Michroma 및 Pretendard 폰트를 가져옵니다 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Michroma&family=Pretendard:wght@400;700;900&display=swap" rel="stylesheet">
  <style>
    /* === 🎨 네온사인 테마 CSS (전체 화면 & 꽉 찬 느낌) === */
    
    /* 0. 전체 배경 및 기본 설정 */
    body {
      font-family: 'Pretendard', sans-serif; 
      background-color: #050505; 
      color: #f8f9fa;
      display: flex; flex-direction: column; align-items: center; justify-content: center; 
      min-height: 100vh; overflow: hidden; margin: 0; padding: 20px;
      background-image: 
        linear-gradient(rgba(181, 102, 255, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(181, 102, 255, 0.05) 1px, transparent 1px);
      background-size: 20px 20px;
      box-shadow: inset 0 0 100px rgba(181, 102, 255, 0.2), inset 0 0 100px rgba(84, 193, 255, 0.1);
    }
    
    /* 1. 상단 제목 (네온 깜빡임 효과) */
    h2#studio-title { 
      margin-top: 0; font-family: 'Michroma', sans-serif;
      color: #54c1ff; 
      text-shadow: 0 0 10px rgba(84, 193, 255, 0.8), 0 0 20px rgba(84, 193, 255, 0.5);
      animation: neon-flicker 3s infinite alternate; 
      position: absolute; top: 20px; left: 50%; transform: translateX(-50%);
      z-index: 10;
    }
    
    /* 2. 생성기 전체 컨테이너 (꽉 찬 비율) */
    #studio-container {
      display: flex; gap: 30px; 
      background: rgba(13, 13, 18, 0.8); 
      padding: 30px; 
      border-radius: 12px; 
      border: 2px solid #54c1ff; 
      box-shadow: 0 0 20px rgba(84, 193, 255, 0.5), 0 0 30px rgba(84, 193, 255, 0.3), inset 0 0 10px rgba(84, 193, 255, 0.2);
      width: 90vw; height: 80vh; 
      max-width: 1400px; max-height: 900px;
      position: relative; top: 30px; 
      z-index: 5; /* 아이콘들보다 위에 위치하도록 설정 */
    }
    
    /* 3. 미리보기 캔버스 영역 */
    #canvas-container {
      flex: 1; height: 100%; 
      background: #000; 
      border: 2px solid #ff00de; 
      box-shadow: 0 0 20px rgba(255, 0, 222, 0.5), 0 0 30px rgba(255, 0, 222, 0.3);
      display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden;
    }
    canvas { max-width: 100%; max-height: 100%; box-shadow: 0 0 20px rgba(0,0,0,0.8); }
    
    /* 4. 조작 패널 영역 (스크롤 추가) */
    #control-panel {
      width: 400px; display: flex; flex-direction: column; gap: 15px;
      height: 100%; overflow-y: auto; padding-right: 15px;
    }
    
    #control-panel::-webkit-scrollbar { width: 8px; }
    #control-panel::-webkit-scrollbar-thumb { background: #54c1ff; border-radius: 4px; box-shadow: 0 0 10px rgba(84, 193, 255, 0.5); }

    /* 5. 컨트롤 그룹 공통 네온 스타일 */
    .control-group { 
      background: rgba(0, 0, 0, 0.5); 
      padding: 15px; border-radius: 8px; 
      display: flex; flex-direction: column; gap: 10px; 
      border: 1px solid #ff00de; 
      box-shadow: 0 0 10px rgba(255, 0, 222, 0.3), 0 0 20px rgba(255, 0, 222, 0.1);
    }
    
    .control-group h3 { 
      margin: 0; font-family: 'Michroma', sans-serif; 
      font-size: 1rem; color: #ff00de; 
      text-shadow: 0 0 10px rgba(255, 0, 222, 0.8), 0 0 20px rgba(255, 0, 222, 0.5);
      border-bottom: 1px solid rgba(255, 0, 222, 0.3); padding-bottom: 5px; 
      display: flex; justify-content: space-between; align-items: center;
    }
    
    /* 6. 입력 요소 네온 스타일 */
    .flex-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    label { font-size: 0.85rem; font-weight: bold; color: #ccc; text-shadow: 0 0 5px rgba(204, 204, 204, 0.5); }
    
    input[type="text"], input[type="file"] {
      padding: 8px; background: #000; color: white; 
      border: 1px solid #ff00de; border-radius: 4px; width: 100%; box-sizing: border-box;
      box-shadow: 0 0 10px rgba(255, 0, 222, 0.2); transition: 0.2s;
    }
    input[type="text"]:focus, input[type="file"]:focus {
      box-shadow: 0 0 20px rgba(255, 0, 222, 0.5), 0 0 30px rgba(255, 0, 222, 0.3);
      outline: none;
    }
    
    input[type="range"] { 
      width: 100%; cursor: pointer; 
      accent-color: #54c1ff; 
      box-shadow: 0 0 10px rgba(84, 193, 255, 0.3);
    }
    
    input[type="color"] { width: 40px; height: 40px; cursor: pointer; border: none; padding: 0; background: transparent; }
    
    /* 7. 버튼 및 리스트 항목 네온 스타일 */
    .button-group { display: flex; gap: 5px; }
    
    .ratio-btn, .action-btn { 
      flex: 1; padding: 8px; background: #000; color: #54c1ff; 
      border: 1px solid #54c1ff; border-radius: 4px; cursor: pointer; font-weight: bold; transition: 0.2s; font-size: 0.85rem; font-family: 'Michroma', sans-serif;
      box-shadow: 0 0 10px rgba(84, 193, 255, 0.3);
    }
    
    .ratio-btn.selected { background: #54c1ff; color: #000; border-color: #54c1ff; box-shadow: 0 0 20px rgba(84, 193, 255, 0.5); }
    
    .action-btn:hover { background: #222; box-shadow: 0 0 15px rgba(84, 193, 255, 0.5), 0 0 25px rgba(84, 193, 255, 0.3); }
    
    .action-btn.primary { background: #000; color: #ff00de; border-color: #ff00de; box-shadow: 0 0 10px rgba(255, 0, 222, 0.3); }
    .action-btn.primary:hover { background: #222; box-shadow: 0 0 15px rgba(255, 0, 222, 0.5), 0 0 25px rgba(255, 0, 222, 0.3); }
    
    .action-btn.danger { background: #000; color: #ff5252; border-color: #ff5252; box-shadow: 0 0 10px rgba(255, 82, 82, 0.3); }
    .action-btn.danger:hover { background: #222; box-shadow: 0 0 15px rgba(255, 82, 82, 0.5), 0 0 25px rgba(255, 82, 82, 0.3); }
    
    .action-btn:disabled { background: #000; color: #888; border-color: #888; box-shadow: 0 0 10px rgba(136, 136, 136, 0.2); cursor: not-allowed; }
    
    /* 8. 다운로드 버튼 네온 스타일 (통합 및 애니메이션) */
    #download-btn {
      padding: 15px; background: #000; color: #00e676; 
      border: 2px solid #00e676; border-radius: 8px; font-weight: bold; font-size: 1.1rem; cursor: pointer; margin-top: 5px; font-family: 'Michroma', sans-serif;
      box-shadow: 0 0 15px rgba(0, 230, 118, 0.5), 0 0 25px rgba(0, 230, 118, 0.3);
      animation: neon-flicker 4s infinite alternate; 
      position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);
      z-index: 10;
    }
    #download-btn:hover { background: #004d40; box-shadow: 0 0 25px rgba(0, 230, 118, 0.8), 0 0 35px rgba(0, 230, 118, 0.5); }

    /* 9. 템플릿 리스트 네온 스타일 */
    #template-list-container {
      max-height: 120px; overflow-y: auto;
      border: 1px solid #ff00de; border-radius: 4px; background: #000; margin-bottom: 5px;
      box-shadow: 0 0 10px rgba(255, 0, 222, 0.2);
    }
    #template-list { list-style: none; padding: 0; margin: 0; }
    
    .template-item {
      padding: 10px; border-bottom: 1px solid rgba(255, 0, 222, 0.2); display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-size: 0.9rem; color: #f8f9fa;
    }
    .template-item:hover { background: #1a1a1a; box-shadow: 0 0 10px rgba(255, 0, 222, 0.2); }
    
    .template-item.selected { 
      background: rgba(255, 0, 222, 0.2); 
      border-left: 4px solid #ff00de; 
      box-shadow: 0 0 20px rgba(255, 0, 222, 0.5), 0 0 30px rgba(255, 0, 222, 0.3);
    }
    
    #error-message { color: #ff5252; font-size: 0.8rem; font-weight: bold; display: none; margin-top: 5px; text-shadow: 0 0 5px rgba(255, 82, 82, 0.5); }
    
    /* 10. 배경 네온 조명 아이콘 */
    .neon-icon {
      position: absolute; font-size: 3rem; color: #ff00de; 
      text-shadow: 0 0 15px rgba(255, 0, 222, 0.8), 0 0 25px rgba(255, 0, 222, 0.5);
      animation: neon-flicker-simple 5s infinite alternate;
      z-index: 1;
    }
    @keyframes neon-flicker-simple {
      0%, 100% { text-shadow: 0 0 15px currentColor, 0 0 25px currentColor; opacity: 1; }
      50% { text-shadow: 0 0 10px currentColor, 0 0 20px currentColor; opacity: 0.8; }
    }
    
    /* 책상 위 마우스 */
    #desk-mouse {
      position: absolute; bottom: 20px; right: 5vw; font-size: 4rem; color: #00e676; 
      text-shadow: 0 0 15px rgba(0, 230, 118, 0.8), 0 0 25px rgba(0, 230, 118, 0.5);
      animation: neon-flicker-simple 4s infinite alternate;
      z-index: 1; font-family: 'Michroma', sans-serif;
    }

    /* === 🎬 네온 깜빡임 애니메이션 정의 === */
    @keyframes neon-flicker {
      0%, 100% { text-shadow: 0 0 10px currentColor, 0 0 20px currentColor, 0 0 30px currentColor; opacity: 1; }
      20% { text-shadow: 0 0 10px currentColor, 0 0 20px currentColor; opacity: 1; }
      40% { text-shadow: 0 0 5px currentColor; opacity: 0.8; }
      60% { text-shadow: 0 0 10px currentColor, 0 0 20px currentColor, 0 0 30px currentColor; opacity: 1; }
      80% { text-shadow: 0 0 10px currentColor, 0 0 20px currentColor, 0 0 30px currentColor, 0 0 40px currentColor; opacity: 1; }
    }
  </style>
</head>
<body>

  <!-- 배경 네온 아이콘들 -->
  <div class="neon-icon" style="top:5vh; left:5vw; color: #54c1ff;">📸</div> 
  <div class="neon-icon" style="top:15vh; left:10vw; color: #ff00de; font-size:4rem;">🔥</div> 
  <div class="neon-icon" style="top:5vh; right:10vw; color: #00e676;">🎬</div> 
  <div class="neon-icon" style="top:15vh; right:5vw; color: #ffff00; font-size:4rem;">⭕</div> 
  <div class="neon-icon" style="top:30vh; left:5vw; color: #ffab00; font-size:4.5rem;">➡️</div> 
  
  <h2 id="studio-title">유튜브 프로 썸네일 스튜디오 🎬</h2>

  <div id="studio-container">
    <div id="canvas-container">
      <canvas id="thumbnailCanvas" width="500" height="500"></canvas>
    </div>

    <div id="control-panel">
      <!-- 1. 템플릿 관리 -->
      <div class="control-group">
        <h3>💾 템플릿 관리 
          <span style="font-size: 0.8rem; font-weight: normal; color: #ccc;">(JSON 연동)</span>
        </h3>
        <div id="template-list-container">
          <ul id="template-list">
            <li class="template-item" style="justify-content:center; color:#888;">저장된 템플릿이 없습니다.</li>
          </ul>
        </div>
        <div class="button-group">
          <button class="action-btn primary" id="save-tpl-btn">새로 저장</button>
          <button class="action-btn" id="update-tpl-btn" disabled>수정</button>
          <button class="action-btn danger" id="delete-tpl-btn" disabled>삭제</button>
        </div>
        <div class="button-group" style="margin-top: 5px;">
          <button class="action-btn" id="export-json-btn">📤 JSON 내보내기</button>
          <button class="action-btn" onclick="document.getElementById('import-json-file').click();">📥 JSON 불러오기</button>
          <input type="file" id="import-json-file" accept=".json" style="display:none;">
        </div>
      </div>

      <!-- 2. 비율 설정 -->
      <div class="control-group">
        <h3>📐 화면 비율</h3>
        <div class="button-group">
          <button class="ratio-btn selected" data-width="500" data-height="500">1:1</button>
          <button class="ratio-btn" data-width="400" data-height="500">4:5</button>
          <button class="ratio-btn" data-width="281" data-height="500">9:16</button>
        </div>
      </div>

      <!-- 3. 배경 이미지 & 필터 -->
      <div class="control-group">
        <h3>🖼️ 배경 설정</h3>
        <input type="file" id="imageUpload" accept=".png, .jpg, .jpeg">
        <div id="error-message">⚠️ 지원하지 않는 파일 형식입니다.</div>
        
        <div class="flex-row"><label>밝기</label><input type="range" id="imgBrightness" min="30" max="150" value="80"></div>
        <div class="flex-row"><label>대비</label><input type="range" id="imgContrast" min="50" max="200" value="120"></div>
      </div>

      <!-- 4. 텍스트 디자인 & 🎯 위치/회전 통합 -->
      <div class="control-group">
        <h3>📝 텍스트 디자인 & 🎯 위치</h3>
        <input type="text" id="textInput" value="유튜버 떡상 비법!" placeholder="문구나 이모지(🔥😱➡️⭕) 입력">
        
        <div class="flex-row">
          <div style="display:flex; flex-direction:column; align-items:center;"><label>글자</label><input type="color" id="textColor" value="#ffffff"></div>
          <div style="display:flex; flex-direction:column; align-items:center;"><label>테두리</label><input type="color" id="strokeColor" value="#000000"></div>
          <div style="display:flex; flex-direction:column; align-items:center;"><label>박스</label><input type="color" id="bgColor" value="#ffff00"></div>
        </div>

        <div class="flex-row"><label>크기</label><input type="range" id="textSize" min="20" max="200" value="70"></div>
        <div class="flex-row"><label>테두리 두께</label><input type="range" id="strokeWidth" min="0" max="30" value="10"></div>
        <div class="flex-row"><label>박스 투명도</label><input type="range" id="bgOpacity" min="0" max="100" value="100"></div>
        
        <hr style="width:100%; border:0; border-top:1px solid rgba(255, 0, 222, 0.3); margin: 5px 0;">
        <div class="flex-row"><label>가로 위치(X)</label><input type="range" id="textX" min="0" max="1000" value="250"></div>
        <div class="flex-row"><label>세로 위치(Y)</label><input type="range" id="textY" min="0" max="1000" value="250"></div>
        <div class="flex-row"><label>회전 각도</label><input type="range" id="textRotate" min="-180" max="180" value="0"></div>
      </div>

    </div>
  </div>

  <!-- 책상 위 네온 마우스 (그린) -->
  <div id="desk-mouse">🐭</div>

  <!-- 완성본 다운로드 버튼 -->
  <button id="download-btn">📥 완성본 파일 다운로드</button>

  <script>
    const canvas = document.getElementById('thumbnailCanvas');
    const ctx = canvas.getContext('2d');
    
    const els = {
      imageUpload: document.getElementById('imageUpload'), errorMsg: document.getElementById('error-message'),
      br: document.getElementById('imgBrightness'), co: document.getElementById('imgContrast'),
      txt: document.getElementById('textInput'), tColor: document.getElementById('textColor'),
      sColor: document.getElementById('strokeColor'), bColor: document.getElementById('bgColor'),
      tSize: document.getElementById('textSize'), sWidth: document.getElementById('strokeWidth'),
      bOpacity: document.getElementById('bgOpacity'), x: document.getElementById('textX'),
      y: document.getElementById('textY'), rot: document.getElementById('textRotate')
    };

    let bgImage = null;
    let bgImageSrc = null; 
    let currentWidth = 500;
    let currentHeight = 500;

    const STORAGE_KEY = 'youtube_studio_templates';
    let templates = [];
    let selectedTemplateId = null;

    const tplListEl = document.getElementById('template-list');
    const saveBtn = document.getElementById('save-tpl-btn');
    const updateBtn = document.getElementById('update-tpl-btn');
    const deleteBtn = document.getElementById('delete-tpl-btn');

    function initTemplates() {
      try {
        const data = localStorage.getItem(STORAGE_KEY);
        if (data) templates = JSON.parse(data);
      } catch (e) {
        templates = [];
      }
      renderTemplateList();
    }

    function getCurrentState() {
      return {
        width: currentWidth, height: currentHeight,
        bgSrc: bgImageSrc, br: els.br.value, co: els.co.value,
        txt: els.txt.value, tColor: els.tColor.value, sColor: els.sColor.value, bColor: els.bColor.value,
        tSize: els.tSize.value, sWidth: els.sWidth.value, bOpacity: els.bOpacity.value,
        x: els.x.value, y: els.y.value, rot: els.rot.value
      };
    }

    function applyState(state) {
      currentWidth = state.width; currentHeight = state.height;
      canvas.width = currentWidth; canvas.height = currentHeight;
      document.querySelectorAll('.ratio-btn').forEach(btn => {
        btn.classList.toggle('selected', btn.dataset.width == currentWidth);
      });

      els.br.value = state.br; els.co.value = state.co; els.txt.value = state.txt;
      els.tColor.value = state.tColor; els.sColor.value = state.sColor; els.bColor.value = state.bColor;
      els.tSize.value = state.tSize; els.sWidth.value = state.sWidth; els.bOpacity.value = state.bOpacity;
      els.x.max = currentWidth; els.y.max = currentHeight;
      els.x.value = state.x; els.y.value = state.y; els.rot.value = state.rot;

      bgImageSrc = state.bgSrc;
      if (bgImageSrc) {
        const img = new Image();
        img.onload = () => { bgImage = img; drawCanvas(); };
        img.src = bgImageSrc;
      } else {
        bgImage = null; drawCanvas();
      }
    }

    function renderTemplateList() {
      tplListEl.innerHTML = '';
      localStorage.setItem(STORAGE_KEY, JSON.stringify(templates));

      if (templates.length === 0) {
        tplListEl.innerHTML = '<li class="template-item" style="justify-content:center; color:#888;">저장된 템플릿이 없습니다.</li>';
        updateBtn.disabled = true; deleteBtn.disabled = true;
        return;
      }

      templates.forEach(tpl => {
        const li = document.createElement('li');
        li.className = `template-item ${tpl.id === selectedTemplateId ? 'selected' : ''}`;
        li.textContent = `📝 ${tpl.name}`;
        
        li.onclick = () => {
          selectedTemplateId = tpl.id;
          applyState(tpl.state);
          renderTemplateList(); 
          updateBtn.disabled = false;
          deleteBtn.disabled = false;
        };
        tplListEl.appendChild(li);
      });
      
      updateBtn.disabled = !selectedTemplateId;
      deleteBtn.disabled = !selectedTemplateId;
    }

    saveBtn.onclick = () => {
      const name = prompt("저장할 템플릿 이름을 입력하세요 (예: 테스트3 쇼츠 대박터지는썸넬🔥)");
      if (!name) return;
      
      const newTpl = {
        id: Date.now().toString(),
        name: name,
        state: getCurrentState()
      };
      
      try {
        templates.push(newTpl);
        selectedTemplateId = newTpl.id; 
        renderTemplateList();
        applyState(newTpl.state); 
        alert('성공적으로 저장되었습니다!');
      } catch (e) {
        templates.pop();
        alert('⚠️ 저장 공간이 부족합니다! 해상도가 낮은 이미지를 사용해주세요.');
      }
    };

    updateBtn.onclick = () => {
      if (!selectedTemplateId) return;
      const index = templates.findIndex(t => t.id === selectedTemplateId);
      if (index > -1) {
        templates[index].state = getCurrentState();
        renderTemplateList();
        alert('현재 설정으로 덮어쓰기 완료!');
      }
    };

    deleteBtn.onclick = () => {
      if (!selectedTemplateId) return;
      if (confirm('이 템플릿을 정말 삭제할까요?')) {
        templates = templates.filter(t => t.id !== selectedTemplateId);
        selectedTemplateId = null; 
        renderTemplateList();
        drawCanvas(); 
      }
    };

    document.getElementById('export-json-btn').onclick = () => {
      if (templates.length === 0) return alert('내보낼 템플릿이 없습니다.');
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(templates));
      const dlAnchorElem = document.createElement('a');
      dlAnchorElem.setAttribute("href", dataStr);
      dlAnchorElem.setAttribute("download", "thumbnail_templates.json");
      dlAnchorElem.click();
    };

    document.getElementById('import-json-file').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      
      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const parsed = JSON.parse(event.target.result);
          if (!Array.isArray(parsed)) throw new Error('배열 형식이 아닙니다.');
          
          parsed.forEach(item => {
            if (!item.id || !item.name || !item.state || item.state.txt === undefined) {
              throw new Error('필수 데이터 누락');
            }
          });
          
          templates = parsed;
          selectedTemplateId = null;
          renderTemplateList();
          drawCanvas(); 
          alert('JSON 템플릿을 성공적으로 복원했습니다! 🎉');

        } catch (error) {
          alert('⚠️ 잘못된 형식이거나 손상된 JSON 파일입니다. 기존 데이터가 유지됩니다.');
        }
        e.target.value = ''; 
      };
      reader.readAsText(file);
    });

    document.querySelectorAll('.ratio-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.ratio-btn').forEach(b => b.classList.remove('selected'));
        e.target.classList.add('selected');
        currentWidth = e.target.dataset.width; currentHeight = e.target.dataset.height;
        canvas.width = currentWidth; canvas.height = currentHeight;
        els.x.max = canvas.width; els.y.max = canvas.height;
        drawCanvas();
      });
    });

    els.imageUpload.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      if (file.type !== 'image/png' && file.type !== 'image/jpeg') {
        els.errorMsg.style.display = 'block'; els.imageUpload.value = ''; return; 
      }
      els.errorMsg.style.display = 'none';
      const reader = new FileReader();
      reader.onload = (event) => {
        bgImageSrc = event.target.result; 
        const img = new Image();
        img.onload = () => { bgImage = img; drawCanvas(); };
        img.src = bgImageSrc;
      };
      reader.readAsDataURL(file);
    });

    function drawCanvas() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#000'; ctx.fillRect(0, 0, canvas.width, canvas.height);

      if (bgImage) {
        ctx.filter = `brightness(${els.br.value}%) contrast(${els.co.value}%)`;
        const scale = Math.max(canvas.width / bgImage.width, canvas.height / bgImage.height);
        const imgX = (canvas.width / 2) - (bgImage.width / 2) * scale;
        const imgY = (canvas.height / 2) - (bgImage.height / 2) * scale;
        ctx.drawImage(bgImage, imgX, imgY, bgImage.width * scale, bgImage.height * scale);
        ctx.filter = 'none'; 
      }

      const text = els.txt.value; const size = Number(els.tSize.value);
      const px = Number(els.x.value); const py = Number(els.y.value);
      const angle = Number(els.rot.value); const strokeW = Number(els.sWidth.value);
      const bgOp = Number(els.bOpacity.value) / 100;

      ctx.save(); 
      ctx.translate(px, py); ctx.rotate((angle * Math.PI) / 180); 
      
      ctx.font = `900 ${size}px 'Pretendard', sans-serif`;
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      
      if (bgOp > 0 && text.trim() !== "") {
        const metrics = ctx.measureText(text); const textWidth = metrics.width;
        ctx.globalAlpha = bgOp; ctx.fillStyle = els.bColor.value;
        ctx.fillRect(-textWidth/2 - 20, -size/2 - 10, textWidth + 40, size + 20);
        ctx.globalAlpha = 1.0; 
      }
      
      if (strokeW > 0) {
        ctx.strokeStyle = els.sColor.value; ctx.lineWidth = strokeW; ctx.lineJoin = 'round';
        ctx.strokeText(text, 0, 0); 
      }
      
      ctx.fillStyle = els.tColor.value; ctx.fillText(text, 0, 0); 
      ctx.restore(); 
    }

    Object.values(els).forEach(el => {
      if(el.type !== 'file') el.addEventListener('input', drawCanvas);
    });

    document.getElementById('download-btn').addEventListener('click', () => {
      const link = document.createElement('a');
      link.download = 'youtube_thumbnail.png';
      link.href = canvas.toDataURL('image/png');
      document.body.appendChild(link); link.click(); document.body.removeChild(link);
    });

    initTemplates();
    drawCanvas();
  </script>
</body>
</html>
